{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "background": true,
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "link": true,
      "palette": [
        { "slug": "primary",     "color": "#5AC8FB", "name": "Primary Cyan" },
        { "slug": "primary-600", "color": "#2BB4F2", "name": "Primary 600" },
        { "slug": "primary-700", "color": "#129BD8", "name": "Primary 700" },
        { "slug": "primary-50",  "color": "#EAF7FE", "name": "Primary 50" },
        { "slug": "ink",         "color": "#0F1B2D", "name": "Ink" },
        { "slug": "ink-soft",    "color": "#2A3A52", "name": "Ink Soft" },
        { "slug": "muted",       "color": "#6B7A90", "name": "Muted" },
        { "slug": "line",        "color": "#E6ECF3", "name": "Line" },
        { "slug": "bg",          "color": "#FFFFFF", "name": "Background" },
        { "slug": "bg-soft",     "color": "#F6F9FC", "name": "Background Soft" },
        { "slug": "bg-dark",     "color": "#0F1B2D", "name": "Background Dark" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fluid": true,
      "lineHeight": true,
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
        },
        {
          "slug": "manrope",
          "name": "Manrope",
          "fontFamily": "Manrope, Inter, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "sm",   "size": "0.875rem", "name": "Small" },
        { "slug": "base", "size": "1rem",     "name": "Base" },
        { "slug": "lg",   "size": "1.125rem", "name": "Large" },
        { "slug": "xl",   "size": "1.25rem",  "name": "XL" },
        { "slug": "2xl",  "size": "1.5rem",   "name": "2XL" },
        { "slug": "3xl",  "size": "2rem",     "name": "3XL" }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      }
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "lineHeight": "1.6",
      "fontSize": "1rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--manrope)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": { "text": "var(--wp--preset--color--ink)" }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(2rem, 4.4vw, 3.6rem)",
          "fontWeight": "800"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.6rem, 2.6vw, 2.4rem)",
          "fontWeight": "700"
        }
      },
      "h3": {
        "typography": { "fontSize": "1.25rem", "fontWeight": "700" }
      },
      "h4": {
        "typography": { "fontSize": "1.05rem", "fontWeight": "700" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--primary-700)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
      },
      "button": {
        "color": {
          "text": "#FFFFFF",
          "background": "var(--wp--preset--color--primary-700)"
        },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "0.85em", "right": "1.6em", "bottom": "0.85em", "left": "1.6em" } },
        "typography": { "fontWeight": "600" }
      }
    }
  }
}
